	"license": "MIT",
	"scripts": {
		"ac": "pnpm --filter=@unional/async-context",
		"af": "pnpm --filter=async-fp",
		"build": "turbo run build",
		"check": "biome check",
		"clean": "turbo run clean",
		"coverage": "turbo run coverage",
