{
	"name": "@unional/gizmo",
	"version": "2.3.2",
	"description": "Building gizmos",
	"homepage": "https://github.com/cyberuni/async-fp/tree/main/packages/gizmo#readme",
	"bugs": {
		"url": "https://github.com/cyberuni/async-fp/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/async-fp.git",
		"directory": "packages/gizmo"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./esm/index.d.ts",
				"node": "./esm/index.js",
				"default": "./esm/index.js"
			},
			"require": {
				"types": "./cjs/index.d.ts",
				"node": "./cjs/index.js",
				"default": "./cjs/index.js"
			},
			"default": "./esm/index.js"
		},
		"./testing": {
			"import": {
				"types": "./esm/testing.d.ts",
				"node": "./esm/testing.js",
				"default": "./esm/testing.js"
			},
			"require": {
				"types": "./cjs/testing.d.ts",
				"node": "./cjs/testing.js",
				"default": "./cjs/testing.js"
			},
			"default": "./esm/testing.js"
		}
	},
	"main": "./cjs/index.js",
	"module": "./esm/index.js",
	"jsnext:main": "./esm/index.js",
	"types": "./esm/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"testing",
		"ts",
		"!**/*.{spec,unit,accept,system,perf,stress,test}.*"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf cjs esm coverage *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"lint": "biome check .",
		"nuke": "pnpm clean && rimraf node_modules",
		"prepublishOnly": "pnpm build",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc",
		"verify": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run coverage",
		"w": "pnpm test:watch"
	},
	"dependencies": {
		"type-plus": "8.0.0-beta.8"
	},
	"devDependencies": {
		"@repobuddy/typescript": "^2.0.0",
		"@vitest/coverage-v8": "^4.1.11",
		"assertron": "^11.0.1",
		"rimraf": "^6.0.0",
		"tsdown": "^0.22.14",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">= 14.16"
	},
	"publishConfig": {
		"access": "public"
	}
}
