{
	"name": "async-fp",
	"version": "9.0.15",
	"description": "Utility library for asynchronous functional programming",
	"keywords": [
		"async",
		"context",
		"dependency",
		"functional",
		"typescript"
	],
	"homepage": "https://github.com/cyberuni/async-fp/tree/main/packages/async-fp",
	"bugs": {
		"url": "https://github.com/cyberuni/async-fp/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/async-fp.git",
		"directory": "packages/async-fp"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./esm/index.d.ts",
				"default": "./esm/index.js"
			},
			"require": {
				"types": "./cjs/index.d.ts",
				"default": "./cjs/index.js"
			}
		},
		"./gizmo": {
			"import": {
				"types": "./esm/gizmo.d.ts",
				"default": "./esm/gizmo.js"
			},
			"require": {
				"types": "./cjs/gizmo.d.ts",
				"default": "./cjs/gizmo.js"
			}
		},
		"./gizmo/testing": {
			"import": {
				"types": "./esm/gizmo_testing.d.ts",
				"default": "./esm/gizmo_testing.js"
			},
			"require": {
				"types": "./cjs/gizmo_testing.d.ts",
				"default": "./cjs/gizmo_testing.js"
			}
		}
	},
	"main": "./cjs/index.js",
	"module": "./esm/index.js",
	"jsnext:main": "./esm/index.js",
	"types": "./esm/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system}.*"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf cjs esm coverage *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"lint": "biome check .",
		"nuke": "pnpm clean && rimraf node_modules",
		"prepublishOnly": "pnpm build",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc",
		"verify": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run coverage"
	},
	"dependencies": {
		"@unional/async-context": "workspace:^",
		"@unional/gizmo": "workspace:^"
	},
	"devDependencies": {
		"@repobuddy/typescript": "^2.1.0",
		"@vitest/coverage-v8": "^4.1.11",
		"assertron": "^11.5.3",
		"rimraf": "^6.1.3",
		"tsdown": "^0.22.14",
		"type-plus": "8.0.0-beta.8",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">= 14.16"
	},
	"publishConfig": {
		"access": "public"
	}
}
