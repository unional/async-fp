{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": "unional baseline, inlined: single updater, GitHub-native automerge, release-age soak. Mirrors apply-repo-baseline's canonical preset until github>unional/renovate-preset carries it.",
	"extends": [
		"config:recommended",
		":preserveSemverRanges",
		":semanticCommits"
	],
	"minimumReleaseAge": "3 days",
	"platformAutomerge": true,
	"rebaseWhen": "behind-base-branch",
	"packageRules": [
		{
			"matchUpdateTypes": [
				"minor",
				"patch",
				"pin",
				"digest"
			],
			"automerge": true
		},
		{
			"matchDepTypes": [
				"devDependencies"
			],
			"automerge": true
		},
		{
			"matchUpdateTypes": [
				"major"
			],
			"automerge": false,
			"additionalBranchPrefix": "major-"
		}
	],
	"vulnerabilityAlerts": {
		"minimumReleaseAge": "1 day",
		"automerge": true
	},
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true
	}
}
